{
  "title": "Reglas Videyt - Apps & Meeting Control",
  "rules": [
    {
      "description": "Tecla 1: Abrir/Enfocar Arc Browser",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "shell_command": "open -a 'Arc'" }],
          "conditions": [
            { "type": "device_if", "identifiers": [{ "vendor_id": 4489, "product_id": 34960 }] }
          ]
        }
      ]
    },
    {
      "description": "Tecla 2: Abrir/Enfocar Ghostty CLI",
      "manipulators": [
        {
          "type": "basic",
