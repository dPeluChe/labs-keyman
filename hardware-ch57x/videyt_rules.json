    {
      "description": "Tecla 5: Toggle Mute (Atajo Zoom Cmd+Shift+A)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "5",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "a",
              "modifiers": ["left_command", "left_shift"]
